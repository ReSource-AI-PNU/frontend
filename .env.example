# 실제 값은 git에서 제외된 .env.local에 둔다. 이 파일에는 키 이름과 비밀이 아닌 예시만 적는다.

# 화면(/app)이 부르는 백엔드. 접두어 /api/v3까지 적는다. 빌드할 때 번들에 박힌다.
# 로컬: backend에서 `python3 -m app.v3.devserver --port 8000`
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v3

# 배포: 브라우저는 프런트의 /api/v3만 부르고, 프런트 서버가 백엔드로 넘긴다(백엔드 주소와 조직 토큰이 브라우저에 가지 않는다).
#   NEXT_PUBLIC_API_BASE=/api/v3
#   V3_BACKEND_URL=https://<백엔드 주소>/api/v3
#   V3_ORG_TOKENS={"org_hanbit":"<토큰>", ...}   # 백엔드가 V3_AUTH=token일 때만. 백엔드의 V3_ORG_TOKENS와 같은 값
V3_BACKEND_URL=
V3_ORG_TOKENS=

# v2 화면의 경제 미리보기가 부르는 백엔드(/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Auth.js. AUTH_SECRET은 `openssl rand -base64 33`으로 만든다(여기에 적지 않는다).
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# 이름·이메일만으로 들어가는 시연용 계정. 운영 배포에서는 false
AUTH_DEV_LOGIN=true

# Microsoft Entra External ID. 세 값을 모두 넣으면 Microsoft 로그인 버튼이 켜진다.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
