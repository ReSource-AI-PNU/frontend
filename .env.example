# 실제 값은 git에서 제외된 .env.local(로컬)이나 배포 환경 변수에 둔다. 이 파일에는 키 이름과 비밀이 아닌 예시만 적는다.

# ── 운영(배포) ───────────────────────────────────────────────
# 브라우저는 프런트의 통로(/api/v3)만 부른다. 빌드할 때 번들에 박힌다.
NEXT_PUBLIC_API_BASE=/api/v3
# 프런트 서버가 부를 백엔드. 접두어 /api/v3까지 적는다.
V3_BACKEND_URL=https://<백엔드 주소>/api/v3
# 백엔드 인증 모드. 운영은 bff: 서버 키와 X-User-Id(로그인한 사람), X-Org-Id(세션의 활성 회사)를 붙인다.
V3_AUTH=bff
# 백엔드와 나눠 가진 서버 키. 브라우저로 가지 않는다(Key Vault 등에서 주입).
V3_BFF_KEY=

# Auth.js. AUTH_SECRET은 `openssl rand -base64 33`으로 만든다(여기에 적지 않는다).
AUTH_SECRET=
# 초대 링크(${AUTH_URL}/invite/<토큰>)와 로그인 돌아올 주소에 쓴다.
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# (선택) Microsoft 로그인. 세 값을 모두 넣었을 때만 버튼이 나온다.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ── 로컬 개발 ─────────────────────────────────────────────────
# 백엔드 로컬 서버(header 모드, `python3 -m app.v3.devserver --port 8000`)로 개발할 때:
#   V3_BACKEND_URL=http://localhost:8000/api/v3
#   V3_AUTH=header
#   AUTH_DEV_LOGIN=true   # 이름·이메일만으로 들어가는 개발용 빠른 로그인. bff 모드에서는 켜지지 않는다
# 예전 방식(회사별 토큰, 백엔드 V3_AUTH=token)도 V3_AUTH=token, V3_ORG_TOKENS={"org_id":"토큰"}로 쓸 수 있다.

# v2 화면의 경제 미리보기가 부르는 백엔드(/api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
